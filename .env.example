# Gemini API key for AI text and photo nutrition lookup (server-only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: Turso / libSQL connection (injected automatically by Vercel Turso integration).
# When omitted locally, the app defaults to file:data/calorie-tracker.db.
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=YOUR_TURSO_AUTH_TOKEN
